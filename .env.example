# Neon Postgres connection string (use the pooled connection string from the Neon dashboard)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Optional: direct (non-pooled) connection used by drizzle-kit migrations
DATABASE_URL_UNPOOLED=""

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Also used as the site origin for Stripe return URLs
BETTER_AUTH_URL="http://localhost:3000"

# Stripe (use test-mode keys, sk_test_..., until you go live)
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook (whsec_...).
# Leave empty until the site is deployed; the return page still confirms payments without it.
STRIPE_WEBHOOK_SECRET=""

# Resend
RESEND_API_KEY=""