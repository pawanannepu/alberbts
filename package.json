{
  "name": "alberbts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:admin": "tsx src/db/grant-admin.ts",
    "test": "tsx --test \"tests/unit/**/*.test.{ts,tsx}\"",
    "test:db": "RUN_DB_TESTS=1 EMAIL_DRY_RUN=1 tsx --env-file=.env.local --test \"tests/db/**/*.test.ts\"",
    "test:smoke": "tsx --test \"tests/smoke/**/*.test.ts\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.35.0",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
